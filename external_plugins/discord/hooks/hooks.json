{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh --start '🐾 working…'" } ] }
    ],
    "PreToolUse": [
      { "matcher": "^(Read|WebFetch|mcp__(plugin_)?(discord|slack)(_(discord|slack))?__download_attachment)$", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '📖 reading…'" } ] },
      { "matcher": "Grep|Glob|WebSearch", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '🔍 searching…'" } ] },
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '✏️ editing…'" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '>_ bash…'" } ] },
      { "matcher": "Task|Agent", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '🤝 delegating…'" } ] },
      { "matcher": "^mcp__(plugin_)?(discord|slack)(_(discord|slack))?__(reply|bulk_reply|react|send_embed|send_voice_message)$", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '💬 replying…'" } ] },
      { "matcher": "^mcp__(plugin_discord_)?discord__apply_server_spec$", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '🛠️ configuring…'" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '🔄 compacting…'" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh --idle" } ] }
    ],
    "TeammateIdle": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh --idle" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh --idle" } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh '🐾 working…'" } ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/presence/usage_state.py --success" },
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/presence/presence-status.sh --idle" }
      ] }
    ],
    "StopFailure": [
      { "matcher": "rate_limit", "hooks": [
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/presence/usage_state.py --failure" }
      ] }
    ]
  }
}
